namespace DefaultPublisher.POAIApproval;

using Microsoft.Purchases.Archive;
using Microsoft.Purchases.Document;

page 50102 "POAI Version Change Details"
{
    ApplicationArea = All;
    Caption = 'Purchase Order Version Change Details';
    DataCaptionExpression = PageCaptionExpr;
    DeleteAllowed = false;
    Editable = false;
    InsertAllowed = false;
    ModifyAllowed = false;
    PageType = Document;
    SourceTable = "POAI Approval Change Summary";
    UsageCategory = None;

    layout
    {
        area(Content)
        {
            group(Overview)
            {
                Caption = 'Version Overview';

                field("Document No."; Rec."Document No.")
                {
                    ApplicationArea = All;
                    ToolTip = 'Specifies the Purchase Order number under approval.';
                }
                field("Current Version Label"; Rec."Current Version Label")
                {
                    ApplicationArea = All;
                    ToolTip = 'Specifies the version comparison being reviewed.';
                }
                field("Buy-from Vendor No."; Rec."Buy-from Vendor No.")
                {
                    ApplicationArea = All;
                    ToolTip = 'Specifies the vendor number on the Purchase Order.';
                }
                field("Buy-from Vendor Name"; Rec."Buy-from Vendor Name")
                {
                    ApplicationArea = All;
                    ToolTip = 'Specifies the vendor name on the Purchase Order.';
                }
                field("Previous Version No."; Rec."Previous Version No.")
                {
                    ApplicationArea = All;
                    ToolTip = 'Specifies the baseline version number in Purchase Order Archive.';
                }
                field("Baseline Date Archived"; Rec."Baseline Date Archived")
                {
                    ApplicationArea = All;
                    ToolTip = 'Specifies when the baseline version was archived.';
                }
                field("Baseline Archived By"; Rec."Baseline Archived By")
                {
                    ApplicationArea = All;
                    ToolTip = 'Specifies who archived the baseline version.';
                }
                field("Currency Code"; Rec."Currency Code")
                {
                    ApplicationArea = All;
                    ToolTip = 'Specifies the currency code of the Purchase Order.';
                }
                field("Old Amount"; Rec."Old Amount")
                {
                    ApplicationArea = All;
                    ToolTip = 'Specifies the net amount excl. VAT of the baseline archived version.';
                }
                field("New Amount"; Rec."New Amount")
                {
                    ApplicationArea = All;
                    ToolTip = 'Specifies the net amount excl. VAT of the Purchase Order submitted for approval.';
                }
                field("Amount Variance"; Rec."Amount Variance")
                {
                    ApplicationArea = All;
                    StyleExpr = VarianceStyle;
                    ToolTip = 'Specifies the net amount difference between the current Purchase Order and the baseline archived version.';
                }
                field("Old Amount Incl. VAT"; Rec."Old Amount Incl. VAT")
                {
                    ApplicationArea = All;
                    ToolTip = 'Specifies the total amount incl. VAT of the baseline archived version.';
                }
                field("New Amount Incl. VAT"; Rec."New Amount Incl. VAT")
                {
                    ApplicationArea = All;
                    ToolTip = 'Specifies the total amount incl. VAT of the Purchase Order submitted for approval.';
                }
                field("AI Status"; Rec."AI Status")
                {
                    ApplicationArea = All;
                    ToolTip = 'Specifies whether the summary was generated by Azure OpenAI, deterministic fallback, or is an initial submission.';
                }
                field("Generated DateTime"; Rec."Generated DateTime")
                {
                    ApplicationArea = All;
                    ToolTip = 'Specifies when the summary was generated.';
                }
                field("Last Error Message"; Rec."Last Error Message")
                {
                    ApplicationArea = All;
                    Style = Attention;
                    Visible = HasLastError;
                    ToolTip = 'Specifies the last Azure OpenAI error encountered when falling back to deterministic summary.';
                }
            }
            group(SummaryGroup)
            {
                Caption = 'Executive Change Summary';

                field(EffectiveSummaryField; EffectiveSummaryText)
                {
                    ApplicationArea = All;
                    Editable = false;
                    MultiLine = true;
                    ShowCaption = false;
                    ToolTip = 'Displays the AI-generated or deterministic summary of changes compared to the previous version.';
                }
            }
            group(CountsGroup)
            {
                Caption = 'Change Breakdown Counts';

                field("Header Changes Count"; Rec."Header Changes Count")
                {
                    ApplicationArea = All;
                    ToolTip = 'Specifies how many tracked header fields changed.';
                }
                field("Lines Added Count"; Rec."Lines Added Count")
                {
                    ApplicationArea = All;
                    ToolTip = 'Specifies how many lines were added.';
                }
                field("Lines Modified Count"; Rec."Lines Modified Count")
                {
                    ApplicationArea = All;
                    ToolTip = 'Specifies how many existing lines were modified.';
                }
                field("Lines Deleted Count"; Rec."Lines Deleted Count")
                {
                    ApplicationArea = All;
                    ToolTip = 'Specifies how many lines were deleted.';
                }
                field("Comments Changed Count"; Rec."Comments Changed Count")
                {
                    ApplicationArea = All;
                    ToolTip = 'Specifies how many comments were added, modified, or deleted.';
                }
            }
            part(ChangeDetails; "POAI Change Detail Subform")
            {
                ApplicationArea = All;
                SubPageLink = "Workflow Step Instance ID" = field("Workflow Step Instance ID");
            }
        }
    }

    actions
    {
        area(Processing)
        {
            action(RegenerateAISummary)
            {
                ApplicationArea = All;
                Caption = 'Regenerate AI Summary';
                Enabled = CanRegenerateAI;
                Image = Sparkle;
                ToolTip = 'Re-runs Azure OpenAI summarization using the stored diff payload.';

                trigger OnAction()
                var
                    ApprovalSubscribers: Codeunit "POAI Approval Subscribers";
                begin
                    if ApprovalSubscribers.RegenerateAISummary(Rec) then begin
                        LoadCalculatedFields();
                        CurrPage.Update(false);
                        Message(RegeneratedMsg);
                    end else begin
                        LoadCalculatedFields();
                        CurrPage.Update(false);
                        if Rec."Last Error Message" <> '' then
                            Message(RegenerateFailedWithErrMsg, Rec."Last Error Message")
                        else
                            Message(RegenerateNotConfiguredMsg);
                    end;
                end;
            }
            action(AskCopilot)
            {
                ApplicationArea = All;
                Caption = 'Ask Copilot About Changes';
                Enabled = CanAskCopilot;
                Image = Sparkle;
                ToolTip = 'Opens an interactive Copilot dialog to ask specific questions about the changes in this Purchase Order revision.';

                trigger OnAction()
                var
                    PromptPage: Page "POAI Change Summary Prompt";
                begin
                    PromptPage.LoadSummary(Rec);
                    PromptPage.RunModal();
                end;
            }
            action(OpenPurchaseOrder)
            {
                ApplicationArea = All;
                Caption = 'Open Purchase Order';
                Image = Document;
                ToolTip = 'Opens the current Purchase Order card.';

                trigger OnAction()
                var
                    PurchaseHeader: Record "Purchase Header";
                begin
                    if PurchaseHeader.Get(Rec."Document Type", Rec."Document No.") then
                        Page.Run(Page::"Purchase Order", PurchaseHeader)
                    else
                        Message(PurchaseOrderNotFoundMsg, Rec."Document No.");
                end;
            }
            action(OpenArchiveVersion)
            {
                ApplicationArea = All;
                Caption = 'Open Baseline Archived Version';
                Enabled = HasPreviousVersion;
                Image = History;
                ToolTip = 'Opens the previous archived Purchase Order version used as the comparison baseline.';

                trigger OnAction()
                var
                    PurchaseHeaderArchive: Record "Purchase Header Archive";
                begin
                    if PurchaseHeaderArchive.Get(
                        Rec."Document Type", Rec."Document No.", Rec."Doc. No. Occurrence", Rec."Previous Version No.")
                    then
                        Page.Run(Page::"Purchase Order Archive", PurchaseHeaderArchive)
                    else
                        Message(ArchiveNotFoundMsg, Rec."Previous Version No.", Rec."Document No.");
                end;
            }
        }
        area(Promoted)
        {
            group(Category_Process)
            {
                Caption = 'Process';

                actionref(AskCopilot_Promoted; AskCopilot)
                {
                }
                actionref(RegenerateAISummary_Promoted; RegenerateAISummary)
                {
                }
                actionref(OpenPurchaseOrder_Promoted; OpenPurchaseOrder)
                {
                }
                actionref(OpenArchiveVersion_Promoted; OpenArchiveVersion)
                {
                }
            }
        }
    }

    trigger OnAfterGetCurrRecord()
    begin
        LoadCalculatedFields();
    end;

    var
        EffectiveSummaryText: Text;
        PageCaptionExpr: Text;
        VarianceStyle: Text;
        CanRegenerateAI: Boolean;
        CanAskCopilot: Boolean;
        HasPreviousVersion: Boolean;
        HasLastError: Boolean;
        RegeneratedMsg: Label 'AI summary regenerated successfully.';
        RegenerateFailedWithErrMsg: Label 'AI summary could not be generated (%1). Showing deterministic summary.', Comment = '%1 = error text';
        RegenerateNotConfiguredMsg: Label 'Azure OpenAI is not configured or active. Showing deterministic summary.';
        PurchaseOrderNotFoundMsg: Label 'Purchase Order %1 is no longer open (it may have been posted or deleted).', Comment = '%1 = Document No.';
        ArchiveNotFoundMsg: Label 'Archived Version %1 of Purchase Order %2 could not be found.', Comment = '%1 = Version No., %2 = Document No.';
        PageCaptionLbl: Label 'Purchase Order %1 - %2', Comment = '%1 = Document No., %2 = Current Version Label';

    local procedure LoadCalculatedFields()
    begin
        EffectiveSummaryText := Rec.GetEffectiveSummaryText();
        PageCaptionExpr := StrSubstNo(PageCaptionLbl, Rec."Document No.", Rec."Current Version Label");
        HasLastError := Rec."Last Error Message" <> '';
        HasPreviousVersion := Rec."Previous Version No." > 0;
        CanRegenerateAI := Rec."Has Differences" and HasPreviousVersion;
        CanAskCopilot := CanRegenerateAI;

        if Rec."Amount Variance" > 0 then
            VarianceStyle := 'Attention'
        else
            if Rec."Amount Variance" < 0 then
                VarianceStyle := 'Favorable'
            else
                VarianceStyle := 'Standard';
    end;
}

