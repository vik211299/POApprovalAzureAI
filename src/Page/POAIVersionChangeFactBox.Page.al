namespace DefaultPublisher.POAIApproval;

using Microsoft.Purchases.Document;
using System.Automation;

page 50101 "POAI Version Change FactBox"
{
    ApplicationArea = All;
    Caption = 'PO Version Changes';
    PageType = CardPart;

    layout
    {
        area(Content)
        {
            field(VersionLabelField; VersionLabelTxt)
            {
                ApplicationArea = All;
                Caption = 'Comparison';
                Editable = false;
                Style = Strong;
                ToolTip = 'Specifies which Purchase Order versions are being compared.';
            }
            field(AmountImpactField; AmountImpactTxt)
            {
                ApplicationArea = All;
                Caption = 'Amount Impact';
                Editable = false;
                StyleExpr = AmountStyle;
                ToolTip = 'Specifies the net amount change compared to the previous archived version.';
            }
            field(ChangeCountsField; ChangeCountsTxt)
            {
                ApplicationArea = All;
                Caption = 'Change Breakdown';
                Editable = false;
                ToolTip = 'Specifies counts of header changes, added lines, modified lines, deleted lines, and comments.';
            }
            field(AIStatusField; AIStatusTxt)
            {
                ApplicationArea = All;
                Caption = 'Summary Source';
                Editable = false;
                ToolTip = 'Specifies whether the summary was generated by AI or deterministic rules.';
            }
            group(SummaryBodyGroup)
            {
                Caption = 'Summary';

                field(SummaryBodyField; SummaryBodyTxt)
                {
                    ApplicationArea = All;
                    Editable = false;
                    MultiLine = true;
                    ShowCaption = false;
                    ToolTip = 'Displays the executive summary of Purchase Order changes compared to the previous version.';
                }
            }
        }
    }

    actions
    {
        area(Processing)
        {
            action(ViewDetailedChanges)
            {
                ApplicationArea = All;
                Caption = 'View Detailed Changes';
                Enabled = HasSummaryRecord;
                Image = ViewDetails;
                ToolTip = 'Opens the full side-by-side Version Change Details page with field-level differences.';

                trigger OnAction()
                begin
                    if HasSummaryRecord then
                        Page.Run(Page::"POAI Version Change Details", CurrentSummary);
                end;
            }
            action(AskCopilot)
            {
                ApplicationArea = All;
                Caption = 'Ask Copilot';
                Enabled = HasDifferences;
                Image = Sparkle;
                ToolTip = 'Opens an interactive Copilot dialog to ask follow-up questions about these PO changes.';

                trigger OnAction()
                var
                    PromptPage: Page "POAI Change Summary Prompt";
                begin
                    if HasSummaryRecord then begin
                        PromptPage.LoadSummary(CurrentSummary);
                        PromptPage.RunModal();
                    end;
                end;
            }
            action(ComputeOrRegenerateSummary)
            {
                ApplicationArea = All;
                Caption = 'Refresh / Regenerate Summary';
                Enabled = CanComputeOrRegenerate;
                Image = Refresh;
                ToolTip = 'Computes the change summary if missing, or regenerates the AI summary from the stored diff.';

                trigger OnAction()
                var
                    PurchaseHeader: Record "Purchase Header";
                    ApprovalSubscribers: Codeunit "POAI Approval Subscribers";
                begin
                    if HasSummaryRecord then
                        ApprovalSubscribers.RegenerateAISummary(CurrentSummary)
                    else
                        if PurchaseHeader.Get(Enum::"Purchase Document Type"::Order, CurrentApprovalEntry."Document No.") and
                           (not IsNullGuid(CurrentApprovalEntry."Workflow Step Instance ID"))
                        then
                            ApprovalSubscribers.GenerateChangeSummaryForPurchaseOrder(
                                CurrentApprovalEntry."Workflow Step Instance ID", PurchaseHeader);

                    LoadFromApprovalEntry(CurrentApprovalEntry);
                end;
            }
        }
    }

    var
        CurrentApprovalEntry: Record "Approval Entry";
        CurrentSummary: Record "POAI Approval Change Summary";
        VersionLabelTxt: Text[50];
        AmountImpactTxt: Text[100];
        ChangeCountsTxt: Text[100];
        AIStatusTxt: Text[50];
        SummaryBodyTxt: Text;
        AmountStyle: Text;
        HasSummaryRecord: Boolean;
        HasDifferences: Boolean;
        CanComputeOrRegenerate: Boolean;
        NotCapturedLabelTxt: Label 'Not captured';
        NotCapturedBodyTxt: Label 'No change summary has been captured for this approval request yet. Choose Refresh / Regenerate Summary to compare the current PO against the latest archived version.';
        AmountImpactLbl: Label '%1 -> %2 (%3%4)', Locked = true;
        ChangeCountsLbl: Label 'Hdr %1 | +%2 | ~%3 | -%4', Comment = '%1 = Header changes, %2 = Lines added, %3 = Lines modified, %4 = Lines deleted';

    procedure LoadFromApprovalEntry(ApprovalEntry: Record "Approval Entry"): Boolean
    var
        ApprovalSubscribers: Codeunit "POAI Approval Subscribers";
        SignPrefix: Text;
    begin
        CurrentApprovalEntry := ApprovalEntry;
        Clear(CurrentSummary);
        Clear(VersionLabelTxt);
        Clear(AmountImpactTxt);
        Clear(ChangeCountsTxt);
        Clear(AIStatusTxt);
        Clear(SummaryBodyTxt);
        AmountStyle := 'Standard';
        HasSummaryRecord := false;
        HasDifferences := false;
        CanComputeOrRegenerate := false;

        if (ApprovalEntry."Table ID" <> Database::"Purchase Header") or
           (ApprovalEntry."Document Type" <> ApprovalEntry."Document Type"::Order) or
           (ApprovalEntry."Document No." = '')
        then begin
            CurrPage.Update(false);
            exit(false);
        end;

        if not ApprovalSubscribers.TryGetSummaryForApprovalEntry(ApprovalEntry, CurrentSummary) then begin
            VersionLabelTxt := NotCapturedLabelTxt;
            SummaryBodyTxt := NotCapturedBodyTxt;
            CanComputeOrRegenerate := not IsNullGuid(ApprovalEntry."Workflow Step Instance ID");
            CurrPage.Update(false);
            exit(true);
        end;

        HasSummaryRecord := true;
        HasDifferences := CurrentSummary."Has Differences" and (CurrentSummary."Previous Version No." > 0);
        CanComputeOrRegenerate := HasDifferences;
        VersionLabelTxt := CurrentSummary."Current Version Label";
        AIStatusTxt := Format(CurrentSummary."AI Status");

        if CurrentSummary."Previous Version No." = 0 then begin
            AmountImpactTxt := Format(CurrentSummary."New Amount", 0, '<Precision,2:2><Standard Format,0>');
            ChangeCountsTxt := 'Initial submission';
            AmountStyle := 'Subordinate';
        end else begin
            if CurrentSummary."Amount Variance" > 0 then begin
                SignPrefix := '+';
                AmountStyle := 'Attention';
            end else
                if CurrentSummary."Amount Variance" < 0 then
                    AmountStyle := 'Favorable';

            AmountImpactTxt := CopyStr(StrSubstNo(AmountImpactLbl,
                Format(CurrentSummary."Old Amount", 0, '<Precision,2:2><Standard Format,0>'),
                Format(CurrentSummary."New Amount", 0, '<Precision,2:2><Standard Format,0>'),
                SignPrefix,
                Format(CurrentSummary."Amount Variance", 0, '<Precision,2:2><Standard Format,0>')), 1, MaxStrLen(AmountImpactTxt));

            ChangeCountsTxt := CopyStr(StrSubstNo(ChangeCountsLbl,
                CurrentSummary."Header Changes Count",
                CurrentSummary."Lines Added Count",
                CurrentSummary."Lines Modified Count",
                CurrentSummary."Lines Deleted Count"), 1, MaxStrLen(ChangeCountsTxt));
        end;

        SummaryBodyTxt := CurrentSummary.GetEffectiveSummaryText();
        CurrPage.Update(false);
        exit(true);
    end;
}
